---
import CardButton from './CardButton';
interface Props {
	title: string;
	body: string;
	href: string;
	value:string;
	id:number;
	classlist:string;
}

const { href, title, body, value, id, classlist } = Astro.props;
---

<li class={classlist}>
	<CardButton client:load href={href} title={title} body={body} value={value} id={id} />
</li>
